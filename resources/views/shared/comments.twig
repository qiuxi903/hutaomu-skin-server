{# 材质评论区: 服务端渲染首屏(含嵌套回复), 增量由主题 JS 评论模块处理
   (hutaomu-theme.js, PJAX 切页后经 ht:pjax:navigated 事件重新初始化, 事件委托绑定)。
   首屏内容 twig autoescape 转义; JS 增量全部 textContent, 不拼 HTML。
   回复为扁平单层: replies 挂在顶层评论下, 回复的回复归并同线并显示 @对方 #}
<div class="row">
  <div class="col-12">
    <div class="card ht-comments-card" id="ht-comments"
         data-tid="{{ texture.tid }}"
         data-moderation="{{ commentModeration ? '1' : '0' }}"
         data-can-comment="{{ auth_check() ? '1' : '0' }}"
         data-has-more="{{ comments['has_more'] ? '1' : '0' }}">
      <div class="card-header">
        <h3 class="card-title">
          <i class="far fa-comments mr-1"></i>评论 <span class="ht-c-count">({{ comments['total'] }})</span>
        </h3>
      </div>
      <div class="card-body">
        <div class="ht-c-list">
          {% for c in comments['items'] %}
            <div class="ht-c-item" id="comment-{{ c['id'] }}" data-id="{{ c['id'] }}">
              <img class="ht-c-avatar" src="{{ c['avatar'] }}" alt="" loading="lazy">
              <div class="ht-c-main">
                <div class="ht-c-meta">
                  <span class="ht-c-name">{{ c['name'] }}</span>
                  {% if c['status'] == 0 %}<span class="badge badge-warning ht-c-pending-badge">审核中</span>{% endif %}
                  <span class="ht-c-time" title="{{ c['time_full'] }}">{{ c['time_text'] }}</span>
                </div>
                <div class="ht-c-content">{{ c['content'] }}</div>
              </div>
              <div class="ht-c-actions">
                {% if c['can_approve'] %}<button type="button" class="ht-c-mini-btn ht-c-approve" data-id="{{ c['id'] }}">通过</button>{% endif %}
                {% if c['can_delete'] %}<button type="button" class="ht-c-mini-btn ht-c-del" data-id="{{ c['id'] }}">删除</button>{% endif %}
                {% if c['can_reply'] %}<button type="button" class="ht-c-mini-btn ht-c-reply" data-id="{{ c['id'] }}">回复</button>{% endif %}
                {% if c['can_report'] %}<button type="button" class="ht-c-mini-btn ht-c-report" data-id="{{ c['id'] }}">举报</button>{% endif %}
              </div>
              {% if c['replies'] %}
                <div class="ht-c-replies">
                  {% for r in c['replies'] %}
                    <div class="ht-c-item ht-c-reply-item" id="comment-{{ r['id'] }}" data-id="{{ r['id'] }}">
                      <img class="ht-c-avatar" src="{{ r['avatar'] }}" alt="" loading="lazy">
                      <div class="ht-c-main">
                        <div class="ht-c-meta">
                          <span class="ht-c-name">{{ r['name'] }}</span>
                          {% if r['reply_name'] %}<span class="ht-c-replyto">回复 @{{ r['reply_name'] }}</span>{% endif %}
                          {% if r['status'] == 0 %}<span class="badge badge-warning ht-c-pending-badge">审核中</span>{% endif %}
                          <span class="ht-c-time" title="{{ r['time_full'] }}">{{ r['time_text'] }}</span>
                        </div>
                        <div class="ht-c-content">{{ r['content'] }}</div>
                      </div>
                      <div class="ht-c-actions">
                        {% if r['can_delete'] %}<button type="button" class="ht-c-mini-btn ht-c-del" data-id="{{ r['id'] }}">删除</button>{% endif %}
                        {% if r['can_reply'] %}<button type="button" class="ht-c-mini-btn ht-c-reply" data-id="{{ r['id'] }}">回复</button>{% endif %}
                        {% if r['can_report'] %}<button type="button" class="ht-c-mini-btn ht-c-report" data-id="{{ r['id'] }}">举报</button>{% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% else %}
            <div class="ht-c-empty">还没有评论，来说点什么吧～</div>
          {% endfor %}
        </div>
        <div class="text-center mt-2">
          <button type="button" class="btn btn-sm btn-outline-secondary ht-c-more" {% if not comments['has_more'] %}hidden{% endif %}>加载更多</button>
        </div>
        {% if auth_check() %}
          <form class="ht-c-form mt-3">
            <textarea class="form-control ht-c-input" rows="3" maxlength="500"
                      placeholder="写下你的评论…（最多 500 字）"></textarea>
            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap">
              <span class="text-muted small">
                <span class="ht-c-counter">0</span>/500{% if commentModeration %} · 发表后需审核通过才会公开展示{% endif %}
              </span>
              <button type="submit" class="btn btn-primary btn-sm ht-c-submit">发表评论</button>
            </div>
          </form>
        {% else %}
          <div class="ht-c-login-hint mt-3 text-muted small">
            <a href="{{ url('auth/login') }}">登录</a> 后即可发表评论
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
