<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}使用文档{% endblock %} - {{ site_name }}</title>
  </head>

  {# 登录用户: 常驻面板骨架(顶部页眉+侧栏); 游客: 保持原顶部导航布局(与关于页同构) #}
  <body class="{{ dark_mode ? 'dark-mode' : '' }} hold-transition {{ auth_check() ? 'sidebar-mini layout-fixed layout-navbar-fixed' : 'layout-top-nav' }}">
    <div class="wrapper">
      {% if auth_check() %}
        {{ include('shared.header') }}
        {{ include('shared.sidebar', {scope: 'user'}) }}
      {% else %}
        <nav class="main-header navbar navbar-expand navbar-{{ navbar_color }} navbar-{{ color_mode }} ml-0">
          <div class="container">
            <div class="navbar-header">
              <a href="{{ url('/') }}" class="navbar-brand">{{ site_name }}</a>
            </div>
            <div class="navbar-custom-menu">
              <ul class="nav navbar-nav">
                <li class="nav-item"><a class="nav-link" href="{{ url('/') }}">首页</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ url('docs') }}">使用文档</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ url('skinlib') }}">{{ trans('general.skinlib') }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ url('about') }}">{{ trans('general.about') }}</a></li>
                {{ include('shared.languages') }}
                <li class="nav-item">
                  <a class="nav-link" href="{{ url('auth/login') }}">
                    <i class="fas fa-sign-in-alt"></i>
                    <span class="d-none d-sm-inline">{{ trans('general.login') }}</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
      {% endif %}

      <div class="content-wrapper">
        <div class="container" id="docs-page">
          {% block docscontent %}{% endblock %}
        </div>
      </div>

      {# 页尾: 与登录态各页(skinlib/user/admin base)同一固定组件,
       规则=侧栏页眉在哪它就在哪 #}
      <footer class="main-footer">
        {{ include('shared.copyright') }}
      </footer>
    </div>
    {{ include('shared.foot') }}
  </body>
</html>
