<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}{% endblock %} - {{ site_name }}</title>
  </head>

  {# 登录用户: 常驻面板骨架(顶部页眉+侧栏, 与用户中心一致); 游客: 保持原顶部导航布局 #}
  <body class="{{ dark_mode ? 'dark-mode' : '' }} hold-transition {{ auth_check() ? 'sidebar-mini layout-fixed layout-navbar-fixed' : 'layout-top-nav' }}">
    <div class="wrapper">
      {% if auth_check() %}
        {{ include('shared.header') }}
        {{ include('shared.sidebar', {scope: 'user'}) }}
      {% else %}
        <nav class="main-header navbar navbar-expand navbar-{{ navbar_color }} navbar-{{ color_mode }} ml-0">
          <div class="container">
            <div class="navbar-header">
              <a href="{{ url('/') }}" class="navbar-brand">{{ site_name }}</a>
            </div>

            <div class="navbar-custom-menu">
              <ul class="nav navbar-nav">
                <li class="nav-item">
                  <a class="nav-link" href="{{ url('skinlib') }}">
                    {{ trans('general.skinlib') }}
                  </a>
                </li>
                {{ include('shared.languages') }}
                <li class="nav-item">
                  <a class="nav-link" href="{{ url('auth/login') }}">
                    <i class="fas fa-user"></i>
                    <span class="d-none d-sm-inline">
                      {{ trans('general.anonymous') }}
                    </span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
      {% endif %}

      {% block content %}{% endblock %}

      <footer class="main-footer">
        <div class="container">
          {{ include('shared.copyright') }}
        </div>
      </footer>
    </div>
    {% block before_foot %}{% endblock %}
    {{ include('shared.foot') }}
  </body>
</html>
