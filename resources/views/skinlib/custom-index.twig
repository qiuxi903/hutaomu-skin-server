{% extends 'skinlib.base' %}

{% block title %}{{ trans('general.skinlib') }}{% endblock %}

{% block content %}
  {# 皮肤库首页: 服务端渲染, 筛选/搜索/排序/可见性全部走 URL 参数(PJAX 友好)。
     关键: skinlib.base 没有自带 .content-wrapper——AdminLTE 的 margin-left:250px
     规则作用于 .content-wrapper, 必须自己包一层, 否则内容全宽铺到侧栏底下 #}
  <div class="content-wrapper">
  <section class="content">
  <div class="container-fluid">
  <div class="content-header d-flex flex-wrap align-items-center mb-2">
    <h1 class="mb-0"><i class="fas fa-archive"></i> {{ trans('general.skinlib') }}</h1>
    <span class="text-muted ml-3">{{ trans('skinlib.filter.total', {'total': textures.total()}) }}</span>
    {% if authed %}
      <a class="btn btn-primary btn-sm ml-auto" href="{{ url('skinlib/upload') }}">
        <i class="fas fa-upload mr-1"></i>{{ trans('skinlib.general.upload-new-skin') }}
      </a>
    {% endif %}
  </div>

  {# ── 筛选栏 ─────────────────────────────── #}
  <div class="card sl-filter-card">
    <div class="card-body p-2 px-3">
      <div class="d-flex flex-wrap align-items-center sl-filter">
        <span class="sl-filter-label"><i class="fas fa-shapes mr-1"></i>{{ trans('skinlib.filter.type') }}</span>
        <div class="sl-chip-group mr-3 mb-1">
          {% set typeChips = [
            {key: 'skin', label: trans('front-end.general.skin')},
            {key: 'cape', label: trans('front-end.general.cape')},
          ] %}
          {% for chip in typeChips %}
            <a class="sl-chip {{ filter == chip.key ? 'active' : '' }}"
               href="{{ url('skinlib') }}?{{ (query|default({}))|merge({filter: chip.key, page: 1})|url_encode }}">{{ chip.label }}</a>
          {% endfor %}
        </div>

        {# 可见性 chips: 管理员三态; 玩家=全部/仅公开/仅我的; 游客无此项 #}
        {% if is_admin %}
          {# 可见性筛选仅管理员: 玩家本来就只能看到公开+自己的 #}
          <span class="sl-filter-label"><i class="fas fa-eye mr-1"></i>{{ trans('skinlib.filter.visibility') }}</span>
          <div class="sl-chip-group mr-3 mb-1">
            {% set visChips = [
              {key: 'all', label: trans('skinlib.filter.vis-all')},
              {key: 'public', label: trans('skinlib.filter.vis-public')},
              {key: 'private', label: trans('skinlib.filter.vis-private')},
            ] %}
            {% for chip in visChips %}
              <a class="sl-chip sl-chip-vis {{ visibility == chip.key ? 'active' : '' }}"
                 href="{{ url('skinlib') }}?{{ (query|default({}))|merge({visibility: chip.key, page: 1})|url_encode }}"
                 title="{{ trans('skinlib.filter.vis-admin-hint') }}">{{ chip.label }}</a>
            {% endfor %}
          </div>
        {% endif %}

        {# 搜索 + 排序 #}
        <form class="d-flex flex-wrap align-items-center ml-auto mt-1" method="get" action="{{ url('skinlib') }}">
          <input type="hidden" name="filter" value="{{ filter }}">
          <input type="hidden" name="visibility" value="{{ visibility }}">
          <div class="input-group input-group-sm mr-2 sl-search">
            <input type="text" name="keyword" class="form-control" placeholder="{{ trans('skinlib.filter.keyword-ph') }}"
                   value="{{ keyword|e }}">
            <div class="input-group-append">
              <button class="btn btn-default" type="submit"><i class="fas fa-search"></i></button>
            </div>
          </div>
          <select name="sort" class="form-control form-control-sm mr-2 sl-sort" style="width: auto;">
            <option value="time" {{ sort == 'time' ? 'selected' : '' }}>{{ trans('skinlib.filter.sort-time') }}</option>
            <option value="likes" {{ sort == 'likes' ? 'selected' : '' }}>{{ trans('skinlib.filter.sort-likes') }}</option>
            <option value="size" {{ sort == 'size' ? 'selected' : '' }}>{{ trans('skinlib.filter.sort-size') }}</option>
          </select>
          <button class="btn btn-sm btn-primary" type="submit"><i class="fas fa-filter mr-1"></i>{{ trans('skinlib.filter.apply') }}</button>
        </form>
      </div>
    </div>
  </div>

  {# ── 材质网格 ─────────────────────────────── #}
  {% if textures.isEmpty() %}
    <div class="card">
      <div class="card-body text-center text-muted py-5">
        <i class="fas fa-box-open fa-2x mb-3 d-block"></i>
        {{ trans('skinlib.filter.empty') }}
      </div>
    </div>
  {% else %}
    <div class="sl-grid">
      {% for item in textures %}
        <div class="card sl-card {{ item.public ? '' : 'sl-private' }}">
          <a class="sl-card-link" href="{{ url('skinlib/show/' ~ item.tid) }}" title="{{ item.name }}">
            <img class="sl-preview" src="{{ item.preview_url }}" alt="{{ item.name }}" loading="lazy">
            <div class="sl-card-body">
              <div class="sl-name" title="{{ item.name }}">{{ item.name }}</div>
              <div class="sl-meta">
                <span class="text-muted" title="{{ trans('skinlib.filter.uploader') }}"><i class="fas fa-user-circle"></i> {{ item.nickname }}</span>
                <span class="text-muted" title="{{ trans('skinlib.filter.likes') }}"><i class="fas fa-heart"></i> {{ item.likes }}</span>
                <span class="text-muted" title="{{ trans('skinlib.filter.type') }}">{{ item.type == 'cape' ? trans('front-end.general.cape') : (item.type == 'alex' ? 'Alex' : 'Steve') }}</span>
              </div>
            </div>
          </a>
          <div class="sl-badges">
            {% if not item.public %}
              <span class="badge badge-pill sl-badge-private"><i class="fas fa-lock"></i> {{ trans('skinlib.filter.badge-private') }}</span>
            {% endif %}
            {% if item.uploader == current_uid %}
              <span class="badge badge-pill sl-badge-mine">{{ trans('skinlib.filter.badge-mine') }}</span>
            {% endif %}
            {% if is_admin and not item.public and item.uploader != current_uid %}
              <span class="badge badge-pill sl-badge-admin"><i class="fas fa-user-shield"></i> {{ trans('skinlib.filter.badge-other-private') }}</span>
            {% endif %}
          </div>
          {# 快捷私密切换: 自己的材质或管理员可切 #}
          {% if authed and (item.uploader == current_uid or is_admin) %}
            <button type="button"
                    class="btn btn-sm sl-privacy-toggle"
                    data-tid="{{ item.tid }}"
                    data-public="{{ item.public ? 1 : 0 }}"
                    data-base="{{ url('texture') }}"
                    title="{{ item.public ? trans('skinlib.filter.set-private-hint') : trans('skinlib.filter.set-public-hint') }}">
              <i class="fas {{ item.public ? 'fa-eye' : 'fa-eye-slash' }}"></i>
            </button>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {# ── 分页 ─────────────────────────────── #}
    {% if textures.hasMorePages() %}
      <nav class="sl-pagination">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item {{ textures.currentPage() == 1 ? 'disabled' : '' }}">
            <a class="page-link" href="{{ url('skinlib') }}?{{ (query|default({}))|merge({page: textures.currentPage() - 1})|url_encode }}"><i class="fas fa-angle-left"></i></a>
          </li>
          {% for p in 1..textures.lastPage() %}
            {% if p == 1 or p == textures.lastPage() or (p >= textures.currentPage() - 2 and p <= textures.currentPage() + 2) %}
              <li class="page-item {{ p == textures.currentPage() ? 'active' : '' }}">
                <a class="page-link" href="{{ url('skinlib') }}?{{ (query|default({}))|merge({page: p})|url_encode }}">{{ p }}</a>
              </li>
            {% elseif p == textures.currentPage() - 3 or p == textures.currentPage() + 3 %}
              <li class="page-item disabled"><span class="page-link">…</span></li>
            {% endif %}
          {% endfor %}
          <li class="page-item {{ textures.currentPage() == textures.lastPage() ? 'disabled' : '' }}">
            <a class="page-link" href="{{ url('skinlib') }}?{{ (query|default({}))|merge({page: textures.currentPage() + 1})|url_encode }}"><i class="fas fa-angle-right"></i></a>
          </li>
        </ul>
      </nav>
    {% endif %}
  {% endif %}

  </div>
  </section>
  </div>
{% endblock %}

{% block before_foot %}
  {# 站点 bundle 启动时会按 blessing.route 挂载原版 React 皮肤库到 .content-wrapper
     (先显示新版再瞬间变回原版的根因)——在 bundle 执行前改写 route 使其不匹配 #}
  <script>
    if (window.blessing) { blessing.route = 'skinlib-custom'; }
  </script>
{% endblock %}
