{% extends 'skinlib.base' %}

{% block title %}{{ trans('general.skinlib') }}{% endblock %}

{% block content %}
  {# 皮肤库首页: 服务端渲染, 筛选/搜索/排序/可见性全部走 URL 参数(PJAX 友好)。
     关键: skinlib.base 没有自带 .content-wrapper——AdminLTE 的 margin-left:250px
     规则作用于 .content-wrapper, 必须自己包一层, 否则内容全宽铺到侧栏底下 #}
  <div class="content-wrapper">
  <section class="content">
  <div class="container-fluid">
  <div class="content-header d-flex flex-wrap align-items-center mb-2">
    <h1 class="mb-0"><i class="fas fa-archive"></i> {{ trans('general.skinlib') }}</h1>
    <span class="text-muted ml-3">共 {{ textures.total() }} 个材质</span>
    {% if authed %}
      <a class="btn btn-primary btn-sm ml-auto" href="{{ url('skinlib/upload') }}">
        <i class="fas fa-upload mr-1"></i>上传新皮肤
      </a>
    {% endif %}
  </div>

  {# ── 筛选栏 ─────────────────────────────── #}
  <div class="card sl-filter-card">
    <div class="card-body p-2 px-3">
      <div class="d-flex flex-wrap align-items-center sl-filter">
        <span class="sl-filter-label"><i class="fas fa-shapes mr-1"></i>类型</span>
        <div class="sl-chip-group mr-3 mb-1">
          {% set typeChips = [
            {key: 'skin', label: '皮肤'},
            {key: 'cape', label: '披风'},
          ] %}
          {% for chip in typeChips %}
            <a class="sl-chip {{ filter == chip.key ? 'active' : '' }}"
               href="{{ url('skinlib') }}?{{ (query|default({}))|merge({filter: chip.key, page: 1})|url_encode }}">{{ chip.label }}</a>
          {% endfor %}
        </div>

        {# 可见性 chips: 管理员三态; 玩家=全部/仅公开/仅我的; 游客无此项 #}
        {% if is_admin %}
          {# 可见性筛选仅管理员: 玩家本来就只能看到公开+自己的 #}
          <span class="sl-filter-label"><i class="fas fa-eye mr-1"></i>可见</span>
          <div class="sl-chip-group mr-3 mb-1">
            {% set visChips = [
              {key: 'all', label: '全部'},
              {key: 'public', label: '仅公开'},
              {key: 'private', label: '仅私密'},
            ] %}
            {% for chip in visChips %}
              <a class="sl-chip sl-chip-vis {{ visibility == chip.key ? 'active' : '' }}"
                 href="{{ url('skinlib') }}?{{ (query|default({}))|merge({visibility: chip.key, page: 1})|url_encode }}"
                 title="管理员可查看全部私密内容">{{ chip.label }}</a>
            {% endfor %}
          </div>
        {% endif %}

        {# 搜索 + 排序 #}
        <form class="d-flex flex-wrap align-items-center ml-auto mt-1" method="get" action="{{ url('skinlib') }}">
          <input type="hidden" name="filter" value="{{ filter }}">
          <input type="hidden" name="visibility" value="{{ visibility }}">
          <div class="input-group input-group-sm mr-2 sl-search">
            <input type="text" name="keyword" class="form-control" placeholder="搜索材质名…"
                   value="{{ keyword|e }}">
            <div class="input-group-append">
              <button class="btn btn-default" type="submit"><i class="fas fa-search"></i></button>
            </div>
          </div>
          <select name="sort" class="form-control form-control-sm mr-2 sl-sort" style="width: auto;">
            <option value="time" {{ sort == 'time' ? 'selected' : '' }}>最新上传</option>
            <option value="likes" {{ sort == 'likes' ? 'selected' : '' }}>最多点赞</option>
            <option value="size" {{ sort == 'size' ? 'selected' : '' }}>体积最大</option>
          </select>
          <button class="btn btn-sm btn-primary" type="submit"><i class="fas fa-filter mr-1"></i>应用</button>
        </form>
      </div>
    </div>
  </div>

  {# ── 材质网格 ─────────────────────────────── #}
  {% if textures.isEmpty() %}
    <div class="card">
      <div class="card-body text-center text-muted py-5">
        <i class="fas fa-box-open fa-2x mb-3 d-block"></i>
        没有符合筛选条件的材质
      </div>
    </div>
  {% else %}
    <div class="sl-grid">
      {% for item in textures %}
        <div class="card sl-card {{ item.public ? '' : 'sl-private' }}">
          <a class="sl-card-link" href="{{ url('skinlib/show/' ~ item.tid) }}" title="{{ item.name }}">
            <img class="sl-preview" src="{{ url('preview/' ~ item.tid) }}" alt="{{ item.name }}" loading="lazy">
            <div class="sl-card-body">
              <div class="sl-name" title="{{ item.name }}">{{ item.name }}</div>
              <div class="sl-meta">
                <span class="text-muted" title="上传者"><i class="fas fa-user-circle"></i> {{ item.nickname }}</span>
                <span class="text-muted" title="点赞"><i class="fas fa-heart"></i> {{ item.likes }}</span>
                <span class="text-muted" title="类型">{{ item.type == 'cape' ? '披风' : (item.type == 'alex' ? 'Alex' : 'Steve') }}</span>
              </div>
            </div>
          </a>
          <div class="sl-badges">
            {% if not item.public %}
              <span class="badge badge-pill sl-badge-private"><i class="fas fa-lock"></i> 私密</span>
            {% endif %}
            {% if item.uploader == current_uid %}
              <span class="badge badge-pill sl-badge-mine">我的</span>
            {% endif %}
            {% if is_admin and not item.public and item.uploader != current_uid %}
              <span class="badge badge-pill sl-badge-admin"><i class="fas fa-user-shield"></i> 他人私密</span>
            {% endif %}
          </div>
          {# 快捷私密切换: 自己的材质或管理员可切 #}
          {% if authed and (item.uploader == current_uid or is_admin) %}
            <button type="button"
                    class="btn btn-sm sl-privacy-toggle"
                    data-tid="{{ item.tid }}"
                    data-public="{{ item.public ? 1 : 0 }}"
                    data-base="{{ url('texture') }}"
                    title="{{ item.public ? '设为私密（仅自己可见）' : '设为公开（所有人可见）' }}">
              <i class="fas {{ item.public ? 'fa-eye' : 'fa-eye-slash' }}"></i>
            </button>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {# ── 加载更多(替代分页): 主题 JS 自动补满最后一行 #}
    {% if textures.hasMorePages() %}
      <div class="sl-more-wrap">
        <button type="button" class="btn sl-more" id="sl-more"
                data-next="{{ textures.currentPage() + 1 }}"
                data-last="{{ textures.lastPage() }}"
                data-url="{{ url('skinlib') }}?{{ (query|default({}))|url_encode }}">
          <i class="fas fa-angle-down mr-1"></i>加载更多
        </button>
      </div>
    {% endif %}
  {% endif %}

  </div>
  </section>
  </div>
{% endblock %}

{% block before_foot %}
  {# 站点 bundle 启动时会按 blessing.route 挂载原版 React 皮肤库到 .content-wrapper
     (先显示新版再瞬间变回原版的根因)——在 bundle 执行前改写 route 使其不匹配 #}
  <script>
    if (window.blessing) { blessing.route = 'skinlib-custom'; }
  </script>
{% endblock %}
