{% extends 'admin.layout' %}

{% block title %}{{ trans('general.dashboard') }}{% endblock %}

{% block content %}
  {{ include('shared.grid') }}

  <div class="ap-card">
    <header class="ap-card-head">
      <h3 class="ap-card-title">{{ trans('admin.panel.dashboard.quick') }}</h3>
    </header>
    <div class="ap-card-body">
      <div class="ap-quick">
        <a href="{{ url('admin/users') }}">
          <span class="ap-quick-icon"><i class="fas fa-users"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.user-manage') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-users') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/players') }}">
          <span class="ap-quick-icon"><i class="fas fa-gamepad"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.player-manage') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-players') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/reports') }}">
          <span class="ap-quick-icon"><i class="fas fa-flag"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.report-manage') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-reports') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/comments') }}">
          <span class="ap-quick-icon"><i class="fas fa-comments"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('admin.panel.comments.title') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-comments') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/docs') }}">
          <span class="ap-quick-icon"><i class="fas fa-book-open"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('admin.panel.docs.title') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-docs') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/theme') }}">
          <span class="ap-quick-icon"><i class="fas fa-paint-brush"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.customize') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-theme') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/plugins/manage') }}">
          <span class="ap-quick-icon"><i class="fas fa-plug"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.plugin-manage') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-plugins') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/options') }}">
          <span class="ap-quick-icon"><i class="fas fa-cog"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.options') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-options') }}</span>
          </span>
        </a>
        <a href="{{ url('admin/status') }}">
          <span class="ap-quick-icon"><i class="fas fa-battery-three-quarters"></i></span>
          <span class="ap-quick-meta">
            <span class="ap-quick-name">{{ trans('general.status') }}</span>
            <span class="ap-quick-desc">{{ trans('admin.panel.dashboard.quick-desc-status') }}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
{% endblock %}
