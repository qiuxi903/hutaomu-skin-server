{% extends 'admin.layout' %}

{% block title %}{{ trans('admin.panel.reports.title') }}{% endblock %}

{% block content_shell %}
  {# app bundle 路由表仍注册着上游遗留的 React 举报页(挂载 .content > .container-fluid,
     整页加载时覆盖服务端内容)。给它一个隐藏空容器吞掉挂载, 本页用独立容器渲染双 Tab。 #}
  <div class="content"><div class="container-fluid d-none" aria-hidden="true"></div></div>

  <div class="ap-banner ap-banner-info">
    <i class="fas fa-info-circle"></i>
    <span>{{ trans('admin.panel.reports.notice') }}</span>
  </div>

  <ul class="nav nav-tabs mb-4">
    <li class="nav-item">
      <a class="nav-link {{ tab == 'texture' ? 'active' : '' }}" href="{{ url('admin/reports') }}">{{ trans('admin.panel.reports.tab-texture') }}</a>
    </li>
    <li class="nav-item">
      <a class="nav-link {{ tab == 'comment' ? 'active' : '' }}" href="{{ url('admin/reports') }}?type=comment">{{ trans('admin.panel.reports.tab-comment') }}</a>
    </li>
  </ul>

  {% if tab == 'texture' %}
    <div class="ap-card ap-card--flush">
      <header class="ap-card-head">
        <h3 class="ap-card-title">{{ trans('admin.panel.reports.pending-texture') }}</h3>
        <span class="badge {{ pending|length ? 'badge-warning' : 'badge-secondary' }}">{{ trans('admin.panel.reports.count', {'count': pending|length}) }}</span>
      </header>
      <div class="ap-card-body">
        <table class="table table-striped ht-rp-table">
          <thead><tr>
            <th>ID</th>
            <th>{{ trans('admin.panel.reports.texture') }}</th>
            <th>{{ trans('admin.panel.reports.uploader') }}</th>
            <th>{{ trans('admin.panel.reports.reporter') }}</th>
            <th>{{ trans('admin.panel.reports.reason') }}</th>
            <th>{{ trans('admin.panel.reports.time') }}</th>
            <th class="text-right">{{ trans('admin.panel.reports.actions') }}</th>
          </tr></thead>
          <tbody>
            {% for r in pending %}
              <tr>
                <td class="ap-muted">{{ r.id }}</td>
                <td>{% if r.texture %}<a href="{{ url('skinlib/show/' ~ r.tid) }}" target="_blank">{{ r.texture.name }}</a>{% else %}{{ trans('admin.panel.reports.texture-deleted') }}{% endif %}</td>
                <td>{{ r.textureUploader.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.uploader }}</span></td>
                <td>{{ r.informer.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.reporter }}</span></td>
                <td class="ht-rp-content" title="{{ r.reason }}">{{ r.reason }}</td>
                <td class="text-nowrap ap-muted">{{ r.report_at|date('Y-m-d H:i') }}</td>
                <td class="text-nowrap text-right">
                  <button type="button" class="btn btn-xs btn-danger ht-rp-act" data-id="{{ r.id }}" data-action="delete">{{ trans('admin.panel.reports.delete-texture') }}</button>
                  <button type="button" class="btn btn-xs btn-outline-danger ht-rp-act" data-id="{{ r.id }}" data-action="ban">{{ trans('admin.panel.reports.ban') }}</button>
                  <button type="button" class="btn btn-xs btn-outline-secondary ht-rp-act" data-id="{{ r.id }}" data-action="reject">{{ trans('admin.panel.reports.reject') }}</button>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="7" class="text-center text-muted py-3">{{ trans('admin.panel.reports.no-pending-texture') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="ap-card ap-card--flush">
      <header class="ap-card-head">
        <h3 class="ap-card-title">{{ trans('admin.panel.reports.resolved') }}</h3>
        <span class="ap-muted" style="font-size:12px;">{{ trans('admin.panel.reports.recent-20') }}</span>
      </header>
      <div class="ap-card-body">
        <table class="table table-striped ht-rp-table">
          <thead><tr>
            <th>ID</th>
            <th>{{ trans('admin.panel.reports.texture') }}</th>
            <th>{{ trans('admin.panel.reports.uploader') }}</th>
            <th>{{ trans('admin.panel.reports.reporter') }}</th>
            <th>{{ trans('admin.panel.reports.reason') }}</th>
            <th>{{ trans('admin.panel.reports.time') }}</th>
            <th>{{ trans('admin.panel.reports.status') }}</th>
          </tr></thead>
          <tbody>
            {% for r in recent %}
              <tr>
                <td class="ap-muted">{{ r.id }}</td>
                <td>{% if r.texture %}<a href="{{ url('skinlib/show/' ~ r.tid) }}" target="_blank">{{ r.texture.name }}</a>{% else %}{{ trans('admin.panel.reports.texture-deleted') }}{% endif %}</td>
                <td>{{ r.textureUploader.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.uploader }}</span></td>
                <td>{{ r.informer.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.reporter }}</span></td>
                <td class="ht-rp-content" title="{{ r.reason }}">{{ r.reason }}</td>
                <td class="text-nowrap ap-muted">{{ r.report_at|date('Y-m-d H:i') }}</td>
                <td>{% if r.status == 1 %}<span class="badge badge-success">{{ trans('admin.panel.reports.badge-resolved') }}</span>{% else %}<span class="badge badge-secondary">{{ trans('admin.panel.reports.badge-rejected') }}</span>{% endif %}</td>
              </tr>
            {% else %}
              <tr><td colspan="7" class="text-center text-muted py-3">{{ trans('admin.panel.reports.no-records') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <div class="ap-card ap-card--flush">
      <header class="ap-card-head">
        <h3 class="ap-card-title">{{ trans('admin.panel.reports.pending-comment') }}</h3>
        <span class="badge {{ pending|length ? 'badge-warning' : 'badge-secondary' }}">{{ trans('admin.panel.reports.count', {'count': pending|length}) }}</span>
      </header>
      <div class="ap-card-body">
        <table class="table table-striped ht-rp-table">
          <thead><tr>
            <th>ID</th>
            <th>{{ trans('admin.panel.reports.comment') }}</th>
            <th>{{ trans('admin.panel.reports.comment-author') }}</th>
            <th>{{ trans('admin.panel.reports.texture-page') }}</th>
            <th>{{ trans('admin.panel.reports.reporter') }}</th>
            <th>{{ trans('admin.panel.reports.reason') }}</th>
            <th>{{ trans('admin.panel.reports.time') }}</th>
            <th class="text-right">{{ trans('admin.panel.reports.actions') }}</th>
          </tr></thead>
          <tbody>
            {% for r in pending %}
              <tr>
                <td class="ap-muted">{{ r.id }}</td>
                <td class="ht-rp-content">{{ r.comment ? r.comment.content : trans('admin.panel.reports.comment-deleted') }}</td>
                <td>{{ r.comment and r.comment.user ? r.comment.user.nickname : trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.uploader }}</span></td>
                <td><a href="{{ url('skinlib/show/' ~ r.tid) }}" target="_blank">{{ r.texture.name ?? ('#' ~ r.tid) }}</a></td>
                <td>{{ r.informer.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.reporter }}</span></td>
                <td class="ht-rp-content" title="{{ r.reason }}">{{ r.reason }}</td>
                <td class="text-nowrap ap-muted">{{ r.report_at|date('Y-m-d H:i') }}</td>
                <td class="text-nowrap text-right">
                  <button type="button" class="btn btn-xs btn-danger ht-rp-act" data-id="{{ r.id }}" data-action="delete" data-kind="delete-comment">{{ trans('admin.panel.reports.delete-comment') }}</button>
                  <button type="button" class="btn btn-xs btn-outline-secondary ht-rp-act" data-id="{{ r.id }}" data-action="reject">{{ trans('admin.panel.reports.reject') }}</button>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="8" class="text-center text-muted py-3">{{ trans('admin.panel.reports.no-pending-comment') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="ap-card ap-card--flush">
      <header class="ap-card-head">
        <h3 class="ap-card-title">{{ trans('admin.panel.reports.resolved') }}</h3>
        <span class="ap-muted" style="font-size:12px;">{{ trans('admin.panel.reports.recent-20') }}</span>
      </header>
      <div class="ap-card-body">
        <table class="table table-striped ht-rp-table">
          <thead><tr>
            <th>ID</th>
            <th>{{ trans('admin.panel.reports.comment') }}</th>
            <th>{{ trans('admin.panel.reports.comment-author') }}</th>
            <th>{{ trans('admin.panel.reports.texture-page') }}</th>
            <th>{{ trans('admin.panel.reports.reporter') }}</th>
            <th>{{ trans('admin.panel.reports.reason') }}</th>
            <th>{{ trans('admin.panel.reports.time') }}</th>
            <th>{{ trans('admin.panel.reports.status') }}</th>
          </tr></thead>
          <tbody>
            {% for r in recent %}
              <tr>
                <td class="ap-muted">{{ r.id }}</td>
                <td class="ht-rp-content">{{ r.comment ? r.comment.content : trans('admin.panel.reports.comment-deleted') }}</td>
                <td>{{ r.comment and r.comment.user ? r.comment.user.nickname : trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.uploader }}</span></td>
                <td><a href="{{ url('skinlib/show/' ~ r.tid) }}" target="_blank">{{ r.texture.name ?? ('#' ~ r.tid) }}</a></td>
                <td>{{ r.informer.nickname ?? trans('admin.panel.reports.user-deleted') }} <span class="text-muted small">#{{ r.reporter }}</span></td>
                <td class="ht-rp-content" title="{{ r.reason }}">{{ r.reason }}</td>
                <td class="text-nowrap ap-muted">{{ r.report_at|date('Y-m-d H:i') }}</td>
                <td>{% if r.status == 1 %}<span class="badge badge-success">{{ trans('admin.panel.reports.badge-resolved') }}</span>{% else %}<span class="badge badge-secondary">{{ trans('admin.panel.reports.badge-rejected') }}</span>{% endif %}</td>
              </tr>
            {% else %}
              <tr><td colspan="8" class="text-center text-muted py-3">{{ trans('admin.panel.reports.no-records') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

  <script>
    (function () {
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var t = {
        confirmDeleteTexture: {{ trans('admin.panel.reports.confirm-delete-texture')|json_encode|raw }},
        confirmBan: {{ trans('admin.panel.reports.confirm-ban')|json_encode|raw }},
        confirmDeleteComment: {{ trans('admin.panel.reports.confirm-delete-comment')|json_encode|raw }},
        confirmReject: {{ trans('admin.panel.reports.confirm-reject')|json_encode|raw }},
        confirmDefault: {{ trans('admin.panel.reports.confirm-default')|json_encode|raw }},
        failed: {{ trans('admin.panel.reports.failed')|json_encode|raw }},
        networkError: {{ trans('admin.panel.reports.network-error')|json_encode|raw }},
      };
      var confirms = {
        'delete-texture': t.confirmDeleteTexture,
        'ban': t.confirmBan,
        'delete-comment': t.confirmDeleteComment,
        'reject': t.confirmReject,
      };
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('.ht-rp-act') : null;
        if (!btn) return;
        var action = btn.dataset.action;
        var key = action === 'delete' ? (btn.dataset.kind || 'delete-texture') : action;
        if (!window.confirm(confirms[key] || t.confirmDefault)) return;
        btn.disabled = true;
        fetch({{ url('admin/reports') | json_encode | raw }} + '/' + btn.dataset.id, {
          method: 'PUT',
          credentials: 'same-origin',
          headers: { 'X-CSRF-TOKEN': token, 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: action }),
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.code === 0) { location.reload(); }
          else { window.alert(d.message || t.failed); btn.disabled = false; }
        }).catch(function () { window.alert(t.networkError); btn.disabled = false; });
      });
    })();
  </script>
{% endblock %}
