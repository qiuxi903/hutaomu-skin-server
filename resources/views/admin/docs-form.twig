{% extends 'admin.layout' %}

{% block title %}{{ doc ? trans('admin.panel.docs.edit-title', {'title': doc.title}) : trans('admin.panel.docs.create') }}{% endblock %}

{% block actions %}
  <a href="{{ url('admin/docs') }}" class="btn btn-secondary"><i class="fas fa-arrow-left mr-1"></i>{{ trans('admin.panel.docs.back') }}</a>
{% endblock %}

{% block content %}
  <div class="ap-card">
    <header class="ap-card-head">
      <h3 class="ap-card-title">{{ doc ? trans('admin.panel.docs.edit-title', {'title': doc.title}) : trans('admin.panel.docs.create') }}</h3>
    </header>
    <div class="ap-card-body">
      {% if errors.any %}
        <div class="ap-banner ap-banner-danger">
          <i class="fas fa-times-circle"></i>
          <span>{% for error in errors.all() %}{{ error }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>
        </div>
      {% endif %}
      <form method="POST" action="{{ doc ? url('admin/docs/' ~ doc.id) : url('admin/docs') }}">
        {{ csrf_field() }}
        {% if doc %}{{ method_field('PUT') }}{% endif %}

        <div class="form-group">
          <label>{{ trans('admin.panel.docs.title-label') }}</label>
          <input type="text" name="title" class="form-control" maxlength="100" required
                 value="{{ old.title ?? (doc ? doc.title : '') }}">
        </div>

        <div class="form-row">
          <div class="form-group col-md-5">
            <label>{{ trans('admin.panel.docs.slug-label') }}</label>
            <input type="text" name="slug" class="form-control" pattern="[a-z0-9-]{1,60}" required
                   placeholder="{{ trans('admin.panel.docs.slug-placeholder') }}"
                   value="{{ old.slug ?? (doc ? doc.slug : '') }}">
          </div>
          <div class="form-group col-md-3">
            <label>{{ trans('admin.panel.docs.group-label') }}</label>
            <input type="text" name="group_name" class="form-control" list="doc-groups"
                   maxlength="60" placeholder="{{ trans('admin.panel.docs.group-placeholder') }}"
                   value="{{ old.group_name ?? (doc ? doc.group_name : '') }}">
            <datalist id="doc-groups">
              {% for g in groups %}<option value="{{ g }}">{% endfor %}
            </datalist>
          </div>
          <div class="form-group col-md-2">
            <label>{{ trans('admin.panel.docs.sort-label') }}</label>
            <input type="number" name="sort" class="form-control" min="0" max="9999"
                   value="{{ old.sort ?? (doc ? doc.sort : 0) }}">
          </div>
          <div class="form-group col-md-2">
            <label>{{ trans('admin.panel.docs.publish') }}</label>
            <div class="custom-control custom-checkbox mt-1">
              <input type="checkbox" class="custom-control-input" id="d-published" name="published" value="1"
                     {% if (old.published ?? ((doc and doc.published) ? '1' : '')) %}checked{% endif %}>
              <label class="custom-control-label" for="d-published">{{ trans('admin.panel.docs.publish-hint') }}</label>
            </div>
          </div>
        </div>

        <div class="form-group mb-2">
          <label>{{ trans('admin.panel.docs.content-label') }}</label>
          <textarea name="content" id="doc-content" class="form-control" rows="18" required
                    style="font-family: SFMono-Regular, Consolas, 'Courier New', monospace; font-size: 13px;"
                    placeholder="{{ trans('admin.panel.docs.content-placeholder') }}">{{ old.content ?? (doc ? doc.content : '') }}</textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{ doc ? trans('admin.panel.docs.save') : trans('admin.panel.docs.create-submit') }}</button>
      </form>

      <div class="border-top pt-3 mt-3">
        <button type="button" class="btn btn-outline-info btn-sm" id="doc-preview-btn">{{ trans('admin.panel.docs.preview') }}</button>
        <div id="doc-preview" class="ht-md ap-card mt-2" style="display:none">
          <div class="ap-card-body"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var btn = document.getElementById('doc-preview-btn');
      var box = document.getElementById('doc-preview');
      var ta = document.getElementById('doc-content');
      if (!btn || !box || !ta) return;
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var t = {
        empty: {{ trans('admin.panel.docs.preview-empty')|json_encode|raw }},
        rendering: {{ trans('admin.panel.docs.preview-rendering')|json_encode|raw }},
        refresh: {{ trans('admin.panel.docs.preview-refresh')|json_encode|raw }},
        failed: {{ trans('admin.panel.docs.preview-failed')|json_encode|raw }},
        networkError: {{ trans('admin.panel.docs.network-error')|json_encode|raw }},
      };
      btn.addEventListener('click', function () {
        if (!ta.value.trim()) { window.alert(t.empty); return; }
        btn.disabled = true;
        btn.textContent = t.rendering;
        fetch({{ url('admin/docs/preview') | json_encode | raw }}, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'X-CSRF-TOKEN': token, 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: ta.value }),
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.code === 0) {
            box.querySelector('.ap-card-body').innerHTML = d.html;
            box.style.display = 'block';
            btn.textContent = t.refresh;
          } else {
            window.alert(d.message || t.failed);
          }
        }).catch(function () { window.alert(t.networkError); })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
{% endblock %}
