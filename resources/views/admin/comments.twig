{% extends 'admin.layout' %}

{% block title %}评论管理{% endblock %}

{% block content %}
  <div class="ap-settings">
    <nav class="ap-settings-nav">
      <div class="ap-banner ap-banner-info" style="margin:0 0 10px;">
        <i class="fas fa-info-circle"></i>
        <span>总开关关闭后前台立即隐藏评论区、接口同时拒绝；开启「需要审核」后新评论先进入待审队列。</span>
      </div>
      <a href="#form-switch">评论开关</a>
      <a href="#panel-pending">待审队列</a>
      <a href="#panel-recent">最近已通过</a>
    </nav>
    <div class="ap-settings-body">
      {{ form.render()|raw }}

      <div class="ap-card ap-card--flush" id="panel-pending">
        <header class="ap-card-head">
          <h3 class="ap-card-title">待审队列</h3>
          <span class="badge {{ pending|length ? 'badge-warning' : 'badge-secondary' }}">{{ pending|length }} 条</span>
        </header>
        <div class="ap-card-body">
          <table class="table table-striped ht-adm-table">
            <thead>
              <tr><th>ID</th><th>材质</th><th>评论人</th><th>内容</th><th>时间</th><th class="text-right">操作</th></tr>
            </thead>
            <tbody>
              {% for c in pending %}
                <tr data-id="{{ c['id'] }}">
                  <td class="ap-muted">{{ c['id'] }}</td>
                  <td><a href="{{ url('skinlib/show/' ~ c['tid']) }}" target="_blank">{{ c['texture_name'] }}</a></td>
                  <td>{{ c['name'] }} <span class="text-muted small">#{{ c['uid'] }}</span></td>
                  <td class="ht-adm-content" title="{{ c['time_full'] }}">{{ c['content'] }}</td>
                  <td class="text-nowrap ap-muted">{{ c['time_text'] }}</td>
                  <td class="text-nowrap text-right">
                    <button type="button" class="btn btn-xs btn-success ht-adm-approve" data-id="{{ c['id'] }}">通过</button>
                    <button type="button" class="btn btn-xs btn-outline-danger ht-adm-del" data-id="{{ c['id'] }}">删除</button>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="6" class="text-center text-muted py-3">没有待审评论</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="ap-card ap-card--flush" id="panel-recent">
        <header class="ap-card-head">
          <h3 class="ap-card-title">最近已通过的评论</h3>
          <span class="ap-muted" style="font-size:12px;">最新 20 条</span>
        </header>
        <div class="ap-card-body">
          <table class="table table-striped ht-adm-table">
            <thead>
              <tr><th>ID</th><th>材质</th><th>评论人</th><th>内容</th><th>时间</th><th class="text-right">操作</th></tr>
            </thead>
            <tbody>
              {% for c in recent %}
                <tr data-id="{{ c['id'] }}">
                  <td class="ap-muted">{{ c['id'] }}</td>
                  <td><a href="{{ url('skinlib/show/' ~ c['tid']) }}" target="_blank">{{ c['texture_name'] }}</a></td>
                  <td>{{ c['name'] }} <span class="text-muted small">#{{ c['uid'] }}</span></td>
                  <td class="ht-adm-content" title="{{ c['time_full'] }}">{{ c['content'] }}</td>
                  <td class="text-nowrap ap-muted">{{ c['time_text'] }}</td>
                  <td class="text-nowrap text-right">
                    <button type="button" class="btn btn-xs btn-outline-danger ht-adm-del" data-id="{{ c['id'] }}">删除</button>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="6" class="text-center text-muted py-3">还没有已通过的评论</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      function act(id, action) {
        var opt = action === 'approve'
          ? { method: 'POST', url: {{ url('admin/comments') | json_encode | raw }} + '/' + id + '/approve' }
          : { method: 'DELETE', url: {{ url('comments') | json_encode | raw }} + '/' + id };
        fetch(opt.url, {
          method: opt.method,
          credentials: 'same-origin',
          headers: { 'X-CSRF-TOKEN': token, 'Accept': 'application/json' },
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.code === 0) { location.reload(); }
          else { window.alert(d.message || '操作失败'); }
        }).catch(function () { window.alert('网络错误'); });
      }
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('.ht-adm-approve, .ht-adm-del') : null;
        if (!btn) return;
        if (btn.classList.contains('ht-adm-del') && !window.confirm('确定删除这条评论？删除后不可恢复。')) return;
        btn.disabled = true;
        act(btn.dataset.id, btn.classList.contains('ht-adm-approve') ? 'approve' : 'del');
      });
    })();
  </script>
{% endblock %}
