{% extends 'admin.layout' %}

{% block title %}{{ trans('general.check-update') }}{% endblock %}

{% block content %}
  <div class="row">
    <div class="col-md-6">
      <div class="ap-card">
        <header class="ap-card-head">
          <h3 class="ap-card-title">{{ trans('admin.update.info.title') }}</h3>
        </header>
        <div class="ap-card-body">
          {% if can_update %}
            <div class="ap-banner ap-banner-info"><i class="fas fa-info-circle"></i><span>{{ trans('admin.update.info.available') }}</span></div>
            <dl class="row mb-0">
              <dt class="col-sm-4 ap-muted" style="font-weight:500;">{{ trans('admin.update.info.versions.latest') }}</dt>
              <dd class="col-sm-8">v{{ info.latest }}</dd>
              <dt class="col-sm-4 ap-muted" style="font-weight:500;">{{ trans('admin.update.info.versions.current') }}</dt>
              <dd class="col-sm-8">v{{ info.current }}</dd>
            </dl>
          {% else %}
            {% if error %}
              <div class="ap-banner ap-banner-danger"><i class="fas fa-times-circle"></i><span>{{ trans('admin.update.errors.connection', {error: error}) }}</span></div>
            {% else %}
              <div class="ap-banner ap-banner-success"><i class="fas fa-check-circle"></i><span>{{ trans('admin.update.info.up-to-date') }}</span></div>
            {% endif %}
            <dl class="row mb-0">
              <dt class="col-sm-4 ap-muted" style="font-weight:500;">{{ trans('admin.update.info.versions.current') }}</dt>
              <dd class="col-sm-8 mb-0">v{{ info.current }}</dd>
            </dl>
          {% endif %}
        </div>
        <footer class="ap-form-foot" style="justify-content:flex-start;">
          {% if can_update %}
            <button class="btn btn-primary" id="update">{{ trans('admin.update.info.button') }}</button>
          {% else %}
            <button class="btn btn-primary" disabled="disabled">{{ trans('admin.update.info.button') }}</button>
          {% endif %}
          <a target="_blank" class="btn btn-secondary"
             href="https://github.com/bs-community/blessing-skin-server/releases">
            {{ trans('admin.update.info.check-github') }}
          </a>
        </footer>
      </div>
    </div>
    <div class="col-md-6">
      <div class="ap-card">
        <header class="ap-card-head">
          <h3 class="ap-card-title">{{ trans('admin.update.cautions.title') }}</h3>
        </header>
        <div class="ap-card-body">
          {{ trans('admin.update.cautions.text')|nl2br }}
          <a href="{{ url('docs/site-update') }}">
            {{ trans('admin.update.cautions.link') }}
          </a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
