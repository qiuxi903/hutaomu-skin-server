                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer class="main-footer">
        <div class="container">
          {{ include('shared.copyright') }}
        </div>
      </footer>
    </div>
      <script>
        (function () {
          var btn = document.getElementById('about-ygg-dnd');
          if (!btn) return;
          document.body.addEventListener('dragstart', function (e) {
            var hit = e.target && e.target.closest ? e.target.closest('#about-ygg-dnd') : null;
            if (!hit) return;
            if (e.dataTransfer) {
              e.dataTransfer.setData('text/plain', 'authlib-injector:yggdrasil-server:' + encodeURIComponent(btn.dataset.clipboardText));
              e.dataTransfer.dropEffect = 'copy';
            }
          });
          btn.addEventListener('click', function () {
            if (navigator.clipboard) {
              navigator.clipboard.writeText(btn.dataset.clipboardText).then(function () {
                var old = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>已复制';
                setTimeout(function () { btn.disabled = false; btn.innerHTML = old; }, 1200);
              });
            }
          });
        })();
      </script>
    {{ include('shared.foot') }}
  </body>
</html>
